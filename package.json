{
  "name": "@intuition-box/caveat-enforcers-registry",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Open registry for ERC-7710 caveat enforcer deployments and evidence.",
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "check": "pnpm check:docs && tsc --noEmit",
    "check:docs": "node scripts/check-docs.mjs",
    "build": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "typescript": "^7.0.2"
  }
}
