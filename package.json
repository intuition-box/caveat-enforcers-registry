{
  "name": "@intuition-box/caveat-enforcers-registry",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Open registry for ERC-7710 caveat enforcer deployments and evidence.",
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "dev": "vite",
    "server": "tsx src/server.ts",
    "check": "pnpm check:docs && tsc --noEmit && tsc -p tsconfig.web.json --noEmit",
    "check:schema": "node scripts/check-graphql-schema.mjs",
    "check:submission-schema": "node scripts/check-submission-schema.mjs",
    "check:reference-enforcers": "node scripts/check-reference-enforcers.mjs",
    "generate:reference-enforcers": "node scripts/generate-reference-enforcers.mjs",
    "generate:reference-metadata": "tsx scripts/generate-reference-metadata.ts",
    "check:reference-metadata": "tsx scripts/generate-reference-metadata.ts --check",
    "generate:composability-seed": "node scripts/generate-composability-triples.mjs",
    "check:composability-seed": "node scripts/check-composability-seed.mjs",
    "check:production": "node scripts/check-production.mjs",
    "check:production:final": "node scripts/check-production.mjs --require-final",
    "query:registry": "node scripts/query-registry.mjs",
    "example:wallet-picker": "node examples/wallet-picker.mjs",
    "check:local-proof": "node_modules/.bin/tsx --test --test-name-pattern=\"backend execution coordinator confirms and indexes an injected submission\" test/backend.test.ts",
    "discover:ontology": "node scripts/discover-ontology-candidates.mjs",
    "seed:reference": "tsx scripts/seed-reference-enforcers.ts",
    "seed:reference-enrichment": "tsx scripts/seed-reference-enrichment.ts",
    "check:seed": "tsc -p tsconfig.scripts.json --noEmit",
    "check:docs": "node scripts/check-docs.mjs",
    "build": "node scripts/build.mjs",
    "test": "node_modules/.bin/tsx --test test/*.test.ts",
    "preview": "vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "seed:composability": "tsx scripts/seed-composability.ts",
    "curate:claim": "tsx scripts/curate-claim.ts",
    "pin:proof": "tsx scripts/pin-proof.ts"
  },
  "devDependencies": {
    "@metamask/smart-accounts-kit": "^1.7.0",
    "@types/d3-force": "^3.0.10",
    "@types/d3-scale": "^4.0.9",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "prettier": "^3.5.3",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.0"
  },
  "dependencies": {
    "@0xintuition/protocol": "^2.0.3",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@rainbow-me/rainbowkit": "2.2.11",
    "@tanstack/react-query": "5.101.4",
    "d3-force": "^3.0.0",
    "d3-scale": "^4.0.2",
    "gsap": "^3.15.0",
    "lenis": "^1.3.25",
    "ogl": "^1.0.11",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "viem": "^2.55.10",
    "wagmi": "2.19.5"
  }
}
